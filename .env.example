# Required for the AI analyzer
ANTHROPIC_API_KEY=sk-ant-...
# Optional: claude-sonnet-5-5 (default, cheaper) or claude-opus-5-5 (higher accuracy)
DESIGNQA_MODEL=claude-sonnet-5-5

# Optional: read frames straight from Figma (Settings > Security > Personal access tokens, scope file_content:read)
FIGMA_TOKEN=

# Optional: ticket trackers (default is local markdown tickets)
CLICKUP_TOKEN=
CLICKUP_LIST_ID=
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Guardrails
DESIGNQA_MIN_CONFIDENCE=0.5
DESIGNQA_AUTO_APPROVE=0.85
